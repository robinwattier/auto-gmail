# ==============================================================================
# CONFIGURATION DE L'AGENT GMAIL (LOCAL & CLOUD 24/7)
# ==============================================================================

# 1. Clé API Google Gemini (utilisé pour gemini-2.5-flash)
# Obtenez une clé gratuite sur https://aistudio.google.com/
GEMINI_API_KEY=votre_cle_gemini_ici

# 2. Prénom/Nom pour la signature des réponses rédigées
USER_NAME=Robin

# 3. Intervalle de vérification en secondes (180s = 3 minutes)
CHECK_INTERVAL_SECONDS=180

# 4. Mode de fonctionnement (Recommandé pour le Cloud 24h/24)
AUTO_DRAFT=true
ENABLE_HEALTHCHECK=true
PORT=8080
NOTIFY_ON_START=false

# ==============================================================================
# 5. NOTIFICATIONS MOBILES & PUSH (Quand le PC / Antigravity est éteint)
# ==============================================================================

# Option A (Recommandé) : TELEGRAM BOT
# 1. Créez un bot en 1 min via @BotFather sur Telegram -> Obtenez le TOKEN
# 2. Envoyez un message à votre bot, puis trouvez votre ID via @userinfobot -> Obtenez le CHAT_ID
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# TELEGRAM_CHAT_ID=123456789

# Option B (Le plus simple - 0 compte) : NTFY.SH
# 1. Installez l'app gratuite 'ntfy' sur iPhone / Android
# 2. Abonnez-vous à un sujet unique de votre choix (ex: robin-gmail-alertes-9988)
# NTFY_TOPIC=robin-gmail-alertes-votre-code-secret
# NTFY_SERVER=https://ntfy.sh

# Option C : DISCORD WEBHOOK
# Créez un webhook dans les paramètres de votre salon Discord
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Option D : PUSHOVER
# PUSHOVER_USER_KEY=
# PUSHOVER_API_TOKEN=

# ==============================================================================
# 6. IDENTIFIANTS GMAIL POUR LE CLOUD (Render, Railway, GitHub Actions)
# ==============================================================================
# Ces valeurs sont générées automatiquement en exécutant 'python auth_setup.py'
# GMAIL_TOKEN_JSON={"token": "...", "refresh_token": "...", "token_uri": "https://oauth2.googleapis.com/token", "client_id": "...", "client_secret": "...", "scopes": ["https://mail.google.com/"]}
# GMAIL_CREDENTIALS_JSON={"installed":{"client_id":"...","client_secret":"..."}}

